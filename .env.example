# Copy to .env and fill in. Never commit the real .env file.
# Note: keep comments on their own line, not inline after "KEY=" — python-dotenv
# treats a trailing "# comment" as the literal value when the left side is empty.

# Gemini 3.5 Flash (originally Gemini 2.5 Flash — deprecated for new API keys/projects)
GOOGLE_API_KEY=

# DeepSeek V4 (OpenAI-compatible API)
DEEPSEEK_API_KEY=

# Claude — not currently used. Originally the LLM judge per the brief, switched
# to Groq below (Claude requires billing; Groq has a usable free tier). Left here
# in case you want to revisit Claude as judge later.
ANTHROPIC_API_KEY=

# Groq (openai/gpt-oss-120b), used as the LLM judge — free tier, and a different
# model family from both generation models (Gemini, DeepSeek), which avoids a
# model favoring its own family's phrasing/reasoning when judging answers.
GROQ_API_KEY=

# voyage-rerank-2, used in the vector RAG pipeline
VOYAGE_API_KEY=
