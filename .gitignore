.venv/
__pycache__/
*.pyc
.env
.DS_Store
.idea/
.vscode/

# external reference repos (cloned, not vendored into this repo)
external/

# raw experiment outputs can be large; keep structure, not contents by default —
# BUT the vector RAG indexes/embeddings/results are expensive to recompute
# (hours of GPU indexing + paid API calls), so those specifically ARE tracked,
# to let `git pull` on this local clone fetch already-computed artifacts from
# the Colab-side run instead of needing to rerun them. See the "sync artifacts"
# cells in pipelines/vector_rag/vector_rag_pipeline.ipynb.
experiments/results/*
!experiments/results/.gitkeep
!experiments/results/vector_rag_index/
!experiments/results/vector_rag_index/**
!experiments/results/vector_rag_costs.jsonl
!experiments/results/vector_rag_stage_hybrid.jsonl
!experiments/results/vector_rag_stage_rerank.jsonl
!experiments/results/vector_rag_stage_selection.jsonl
!experiments/results/vector_rag_stage_generation.jsonl
!experiments/results/vector_rag_stage_scoring.jsonl
!experiments/results/vector_rag_latency.jsonl
!experiments/results/long_context_docs/
!experiments/results/long_context_docs/**
!experiments/results/long_context_stage_generation.jsonl
!experiments/results/long_context_stage_scoring.jsonl
!experiments/results/long_context_costs.jsonl
!experiments/results/long_context_latency.jsonl
!experiments/results/vectorless_rag_index/
!experiments/results/vectorless_rag_index/**
# vectorless_rag_index_flash/ -- NOT vectorless_rag_index/ above -- is what
# Stage 3 navigation (vectorless_rag_stage_navigation.jsonl) actually reads
# trees from (see Stage 2b in pipelines/vectorless_rag/vectorless_rag_pipeline.ipynb).
# Missing here means it was silently uncommittable even after a `git add`.
!experiments/results/vectorless_rag_index_flash/
!experiments/results/vectorless_rag_index_flash/**
!experiments/results/vectorless_rag_stage_navigation.jsonl
!experiments/results/vectorless_rag_stage_generation.jsonl
!experiments/results/vectorless_rag_stage_scoring.jsonl
!experiments/results/vectorless_rag_costs.jsonl
!experiments/results/vectorless_rag_latency.jsonl
# pipelines/experimental/pageindex_hybrid_pipeline.ipynb's own output
!experiments/results/pageindex_hybrid_stage_retrieval.jsonl
!experiments/results/pageindex_hybrid_errors.log
.DS_Store
!experiments/results/vectorless_rag_stage_navigation_expanded.jsonl
!experiments/results/pageindex_hybrid_expanded_stage_retrieval.jsonl
!experiments/results/pageindex_hybrid_expanded_stage_rerank.jsonl
!experiments/results/pageindex_hybrid_expanded_stage_generation.jsonl
!experiments/results/pageindex_hybrid_expanded_stage_scoring.jsonl
!experiments/results/pageindex_hybrid_expanded_costs.jsonl
!experiments/results/plain_rerank_direct_stage_generation.jsonl
!experiments/results/plain_rerank_direct_stage_scoring.jsonl
!experiments/results/plain_rerank_direct_costs.jsonl
!experiments/results/pageindex_hybrid_expanded_latency.jsonl
# Stage 13 of pipelines/experimental/pageindex_hybrid_pipeline.ipynb (rerank, then filter to navigated pages)
!experiments/results/rerank_then_filter_stage_rerank.jsonl
!experiments/results/rerank_then_filter_stage_generation.jsonl
!experiments/results/rerank_then_filter_stage_scoring.jsonl
!experiments/results/rerank_then_filter_costs.jsonl
# Re-scored with score_answer_metric_first (evaluation/rescore_metric_first.py)
!experiments/results/vector_rag_stage_scoring_metric_first.jsonl
!experiments/results/long_context_stage_scoring_metric_first.jsonl
